{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Fitness Manager",
      "type": "process",
      "command": "gcc",
      "args": [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "${workspaceFolder}/personal_fitness_manager.c",
        "-o",
        "${workspaceFolder}/fitness_manager.exe"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run Fitness Manager",
      "type": "process",
      "command": "${workspaceFolder}/fitness_manager.exe",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Build Fitness Manager",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
